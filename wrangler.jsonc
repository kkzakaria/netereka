{
  "name": "netereka",
  "compatibility_date": "2024-12-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",

  // LA BOUTIQUE N'A QU'UNE PORTE : netereka.ci.
  //
  // `workers_dev: true` en ouvrait une seconde,
  // `netereka.koffiz2110.workers.dev`, qui répondait 200 sans
  // `x-robots-tag: noindex` (mesuré le 2026-10-04) — une copie publique du
  // site HORS DE LA ZONE, donc hors des règles de transformation et de toute
  // future règle WAF. Pas d'incident SEO : le `<link rel="canonical">` et le
  // sitemap ne nomment que netereka.ci. Mais une porte dont personne ne se
  // sert et que personne ne surveille finit par être celle qu'on oublie.
  //
  // `preview_urls` reste VRAI, et séparément : les URL de version
  // (`<préfixe>-netereka.<sous-domaine>.workers.dev`) servent aux contrôles
  // NON VISUELS d'une version — codes de réponse, en-têtes, routes. Pas au
  // reste : hors zone, `/cdn-cgi/image/` n'existe pas et la page d'accueil y
  // perd ses 471 images. Pour juger l'apparence, c'est la surcharge de
  // version sur netereka.ci (`npm run observe`).
  //
  // Les deux réglages sont écrits EXPLICITEMENT parce que leur défaut est
  // couplé : depuis wrangler 4.44, `preview_urls` suit `workers_dev` quand il
  // est tu. Passer l'un à faux en taisant l'autre éteindrait les deux.
  "workers_dev": false,
  "preview_urls": true,

  // Permet au Worker de dire QUELLE version a répondu (app/api/version).
  // Sans cela, une surcharge de version qui ne s'applique pas est
  // indiscernable d'une qui s'applique : les deux rendent un 200 normal.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },

  "routes": [
    { "pattern": "netereka.ci/*", "zone_name": "netereka.ci" },
    { "pattern": "www.netereka.ci/*", "zone_name": "netereka.ci" }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "netereka-db",
      "database_id": "4f7ff29e-aa15-47a3-a01c-68792a90f9ba"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "35fe4cd4dd084a629f0ebe1a795064db"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "netereka"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "netereka-opennext-cache"
    }
  ],
  // Plafond mensuel d'images générées, lu par lib/ai/image-budget.ts. Déclaré
  // ICI, et pas posé depuis le tableau de bord, pour deux raisons apprises le
  // 2026-10-02 : une variable ajoutée au tableau de bord est reconstruite à
  // chaque `wrangler deploy` depuis ce fichier, donc elle disparaît au
  // déploiement suivant (c'est ce qui est arrivé — deux versions `dash` à 06:38
  // et 06:39, effacées par les déploiements de 08:05 et 08:59) ; et une valeur
  // budgétaire mérite d'être versionnée, pour qu'on sache quand elle a changé
  // et sur quelle décision.
  //
  // CHAÎNE, pas nombre : `parseMonthlyLimit` appelle `raw.trim()`. Un nombre JSON
  // ici lèverait un TypeError, et la réponse deviendrait « Erreur interne » sans
  // nommer le plafond — un mauvais réglage qui ne se dit pas. Le JSON Schema de
  // wrangler accepte les deux, donc rien ne rattraperait l'erreur.
  //
  // 0 désactiverait explicitement la génération ; retirer cette ligne la ferait
  // refuser en disant que le plafond n'est pas configuré. Les deux sont des
  // états valides et distincts, aucun ne vaut « illimité ».
  "vars": {
    "AI_IMAGE_MONTHLY_LIMIT": "100"
  },

  // Workers Logs ingests and indexes everything the Worker writes to console.
  // It was disabled, which meant console output was emitted and then dropped:
  // nothing was stored, so nothing could be read back. The CSP violation
  // collector in app/api/csp-report/route.ts depends on this — its whole
  // purpose is to leave a record an operator reads over the following weeks.
  //
  // Retention is 7 days (Workers Paid; 3 on Free), so a report covering a
  // longer window has to be assembled from successive reads rather than one
  // query at the end. Persisting to D1 is the alternative if that ever matters.
  //
  // invocation_logs stays on: it carries CPU and wall time per request, which
  // is what tells us whether the sanitizer's bounded scan cost holds under real
  // traffic. Volume is not a concern at this site's scale.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
